# ==============================================================================
# KURUNIME NEXT - PUBLIC TEMPLATE ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# How to use:
# 1. Duplicate this file and rename it to `.env` or `.env.local`:
#    cp .env.example .env.local
# 2. Adjust the values below to match your local or production environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOVIE & TV SERIES API (prasunk-movie-api / Rust Axum Microservice)
# ------------------------------------------------------------------------------
# Backend service endpoint for movies, TV series, genres, and streaming sources.
# Default local port is 3004 with `/v1/api` prefix.
# Replace with your deployed endpoint if hosted remotely.
MOVIE_API_URL=http://localhost:3004/v1/api
NEXT_PUBLIC_MOVIE_API_URL=http://localhost:3004/v1/api

# ------------------------------------------------------------------------------
# 2. ANIME API (Anime Scraper Microservice / Otakudesu Provider)
# ------------------------------------------------------------------------------
# Endpoint for anime releases, schedules, ongoing series, and streaming episodes.
# You can use the public demo endpoint or self-host the scraper service.
ANIME_API_URL=https://anime-api.prasunk.my.id/otakudesu
NEXT_PUBLIC_ANIME_API_URL=https://anime-api.prasunk.my.id/otakudesu

# ------------------------------------------------------------------------------
# 3. MANGA & COMICS API (Manga Scraper Microservice / Komikcast Provider)
# ------------------------------------------------------------------------------
# Endpoint for comics, manga, manhwa, manhua catalogs, and chapter readers.
# You can use the public demo endpoint or self-host the scraper service.
MANGA_API_URL=https://manga-api.prasunk.my.id
NEXT_PUBLIC_MANGA_API_URL=https://manga-api.prasunk.my.id

# ------------------------------------------------------------------------------
# 4. SHORT DRAMA & DRAMA CINA API (Prasunk-ReelshortA-API / Rust Axum Microservice)
# ------------------------------------------------------------------------------
# Endpoint for vertical Chinese short dramas and ReelShort feeds (Port 8080).
# If the service is offline or not configured, the app gracefully falls back
# to a friendly "Coming Soon" notification screen.
DRAMA_API_URL=http://localhost:8080
NEXT_PUBLIC_DRAMA_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. WEBSITE BASE URL & SEO METADATA
# ------------------------------------------------------------------------------
# Base canonical URL used for OpenGraph cards, Twitter previews, and sitemap.xml.
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. SAWERIA DONATION INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# Saweria stream key to display the live QRIS overlay in the donation modal.
# Obtain your key at https://saweria.co/overlay.
# Leave blank or set to dummy value if you do not wish to enable Saweria overlays.
SAWERIA_STREAM_KEY=your_saweria_stream_key_here

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE TURNSTILE ANTI-BOT PROTECTION (Optional in Dev, Recommended in Prod)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA keys to protect the site against automated bots.
# Obtain keys at https://dash.cloudflare.com/ (Turnstile section).
#
# IMPORTANT SECURITY NOTE:
# Notice these keys DO NOT have a `NEXT_PUBLIC_` prefix. They are strictly
# resolved on the server side to prevent them from leaking into client JS bundles.
# If left blank, the app will automatically bypass Turnstile checks in development.
CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# ------------------------------------------------------------------------------
# 8. SERVER HOST & PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Default port and binding host for the Next.js production server.
PORT=3000
HOST=0.0.0.0
